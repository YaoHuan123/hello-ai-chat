{
  "name": "aichat-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "sync:android": "vite build --mode android && cap sync android",
    "run:android": "npm run sync:android && cap run android",
    "build:android:debug": "npm run sync:android && cd android && gradlew.bat assembleDebug",
    "install:android:debug": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:lan-ip": "node scripts/print-lan-ip.mjs",
    "sync:ios": "vite build --mode ios && cap sync ios",
    "run:ios": "npm run sync:ios && cap run ios",
    "ios": "cap open ios",
    "ios:lan-ip": "node scripts/print-lan-ip.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.3",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.3",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.3",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "lightningcss": "^1.32.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
