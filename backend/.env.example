# 复制为 `.env` 后按需填写。勿将含密钥的 `.env` 提交到仓库。
#
# 默认从共享环境加载 AI / 阿里云等密钥（可用 BACKEND_SHARED_ENV 改路径）：
#   E:\hello story2\backend\.env
# 本文件仅保留 hello chat 专用覆盖（PORT、DATA_ROOT、文生图等），后加载、优先级更高。
# 下列项从共享 .env 自动加载，无需在此重复填写：
#   ALIYUN_ACCESS_KEY_*、ALIYUN_SMS_*、OPENAI_*、HTTP(S)_PROXY

PORT=4000
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=7d
DATA_ROOT=data

# 短信 mock：1=本地固定验证码 123456；0=真短信（需 story2 已配齐 ALIYUN_SMS_*）
# ALIYUN_SMS_DEV_MOCK=1
ALIYUN_SMS_DEV_MOCK_CODE=123456

# Mol 建议回复 / 关系推荐 / 朋友圈等：OpenAI 兼容 HTTP（/chat/completions）。
# 未在本文件设置 OPENAI_API_KEY 时，默认从 hello story2 共享 .env 加载（见 config.ts BACKEND_SHARED_ENV）。
# 提示词模板（首次请求时若不存在会自动生成）：<DATA_ROOT>/prompts/
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# OPENAI_API_KEY=
# OPENAI_MODEL=doubao-seed-2-0-pro-260215
# 代码中对 doubao/seed 模型统一发送 thinking: disabled，不输出 reasoning。
# OPENAI_TIMEOUT_MS=15000
#
# AI_REPLY_TRACE=false
#
#   relations/{type}.json       — 每种关系的 guidance、entertainmentGuidance
#   suyan/{suyanId}.json        — 素颜人格 + suggestBlock + entertainment.enabled（合并）
#   suyan-shared.json           — 娱乐向全局 intro / temperature / relationHints
#   prompts/*.txt               — 所有 LLM 提示词模板（缺失即 fail fast）
# AI 交互 trace：<DATA_ROOT>/ai-traces/{suyan_suggest|relation_suggest|guardian_proactive}/
# 改文件后默认缓存；调试时可设 SETTINGS_RELOAD_EACH_READ=true
# 校验 settings 与 prompts：npx ts-node scripts/verify-settings-files.ts
#
# 若 story2 路径不同，可在系统环境或本文件设置：
# BACKEND_SHARED_ENV=E:\path\to\backend\.env
#
# 朋友圈探索分身回复：复用上述 OPENAI_*；提示词模板 <DATA_ROOT>/prompts/moments-explore-system.txt、moments-explore-user.txt
#
# 朋友圈热点：从微博、知乎、抖音抓取热搜，经 LLM 生成问题；默认每小时刷新。
# 缓存：<DATA_ROOT>/hot-topics/feed.json
# 提示词：<DATA_ROOT>/prompts/hot-topics-system.txt、hot-topics-user.txt
# HOT_TOPICS_REFRESH_MS=3600000
# HOT_TOPICS_FETCH_TIMEOUT_MS=12000
# HOT_TOPICS_AI_TIMEOUT_MS=60000
#
# 头像文生图（火山方舟等 OpenAI 兼容 /images/generations）：
# Key / BaseUrl 未设时回落 OPENAI_*（来自共享 .env）；MODEL 必填。
TEXT2IMG_MODEL=doubao-seedream-5-0-260128
# TEXT2IMG_API_KEY=
# TEXT2IMG_BASE_URL=
# TEXT2IMG_TIMEOUT_MS=90000
TEXT2IMG_SIZE=2k
