# 复制为 `.env` 后按需填写。勿将含密钥的 `.env` 提交到仓库。

PORT=3001
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=7d
DATA_ROOT=data

# 阿里云号码认证（Dypnsapi，控制台「号码认证服务」）：
#   - SendSmsVerifyCode 由阿里云生成并保存验证码（returnVerifyCode=false），
#     本服务通过 CheckSmsVerifyCode 校验；本地不需要再自存 OTP。
#   - TemplateCode 就是控制台模板列表里的 6 位编号（如 100001），不是 SMS_xxxxxxxx 形式。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE_LOGIN=
ALIYUN_SMS_TEMPLATE_CODE_DELETE_ACCOUNT=
# 号码认证「方案名」（控制台 → 号码认证 → 方案管理）；多方案时必填，单方案可留空。
# ALIYUN_SMS_SCHEME_NAME=

# 设为 1 时强制走开发 mock（不真发短信，校验码为 ALIYUN_SMS_DEV_MOCK_CODE）。
# ALIYUN_SMS_DEV_MOCK=1
ALIYUN_SMS_DEV_MOCK_CODE=123456
